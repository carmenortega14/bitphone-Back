generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Marca {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  paisOrigen  String?
  fechaFundacion DateTime?
  celulares   Celular[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Celular {
  id          Int       @id @default(autoincrement())
  modelo      String
  descripcion String?
  precio      Float
  stock       Int       @default(0)
  imagenUrl   String?
  color       String?
  almacenamiento Int
  ram         Int
  pantalla    Float
  sistemaOperativo String
  marca       Marca     @relation(fields: [marcaId], references: [id])
  marcaId     Int
  categorias  Categoria[]
  pedidos     ItemPedido[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Categoria {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  celulares   Celular[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Cliente {
  id          Int       @id @default(autoincrement())
  nombre      String
  email       String    @unique
  telefono    String?
  direccion   String?
  pedidos     Pedido[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Pedido {
  id          Int       @id @default(autoincrement())
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  clienteId   Int
  items       ItemPedido[]
  total       Float
  estado      String    @default("Finalizado")
  fecha       DateTime  @default(now())
  direccionEnvio String
  metodoPago  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ItemPedido {
  id          Int       @id @default(autoincrement())
  pedido      Pedido    @relation(fields: [pedidoId], references: [id])
  pedidoId    Int
  celular     Celular   @relation(fields: [celularId], references: [id])
  celularId   Int
  cantidad    Int
  precioUnitario Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}